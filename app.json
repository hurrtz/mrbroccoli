{
  "expo": {
    "name": "Mr Broccoli",
    "slug": "mrbroccoli",
    "scheme": "mrbroccoli",
    "icon": "./assets/appIcon/ios.png",
    "version": "3.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "./plugins/withKokoroBackgroundDownload",
      "expo-font",
      "expo-asset",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mr Broccoli to select photos you choose as prompt context. Mr Broccoli does not scan your photo library.",
          "cameraPermission": "Allow Mr Broccoli to take photos you choose as prompt context.",
          "microphonePermission": "Allow Mr Broccoli to use the microphone for native speech input."
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-iap"
    ],
    "ios": {
      "icon": "./assets/appIcon/ios.png",
      "bundleIdentifier": "com.tobiaswinkler.app.mrbroccoli",
      "deploymentTarget": "16.4",
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "icon": "./assets/appIcon/ios.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon/android-adaptive-foreground.png",
        "backgroundImage": "./assets/appIcon/android-background.png",
        "monochromeImage": "./assets/appIcon/android-adaptive-monochrome.png"
      },
      "package": "com.tobiaswinkler.app.mrbroccoli"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0e7cd75-9566-434e-9116-b78d8b806fcf"
      }
    },
    "owner": "hurrtz"
  }
}
