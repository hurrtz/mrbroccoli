+// All System speech, including previews and fallback playback, uses installed
+// embedded voices. Some Android engines also advertise remote voices here.
+object OfflineSpeechVoices {
+  fun installed(voice: Voice): Boolean =
+    !voice.isNetworkConnectionRequired &&
+      voice.features?.contains(TextToSpeech.Engine.KEY_FEATURE_NOT_INSTALLED) == false
+
+  fun select(voices: Collection<Voice>, requested: String?, locale: Locale, defaultName: String?): Voice? {
+    val installed = voices.filter(::installed)
+    if (!requested.isNullOrBlank()) return installed.firstOrNull { it.name == requested }
+    fun normalized(voice: Voice) = Locale.forLanguageTag(LanguageUtils.getISOCode(voice.locale))
+    return installed.filter { normalized(it).language == locale.language }
+      .sortedWith(
+        compareByDescending<Voice> { it.locale.toLanguageTag().equals(locale.toLanguageTag(), ignoreCase = true) }
+          .thenByDescending { locale.script.isNotEmpty() && it.locale.script == locale.script }
+          .thenByDescending { locale.country.isNotEmpty() && normalized(it).country == locale.country }
+          .thenByDescending { it.name == defaultName }
+          .thenByDescending { it.quality }
+          .thenBy { it.name }
+      ).firstOrNull()
+  }
+}
