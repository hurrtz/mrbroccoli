{
  "name": "mrbroccoli",
  "version": "2.5.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config:verify": "node scripts/verify-native-config-sync.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "pretest": "npm run config:verify",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "i18n:verify": "npm run typecheck && jest __tests__/i18n/translations.test.ts __tests__/constants/localTts.test.ts __tests__/constants/kokoro.test.ts __tests__/constants/providers/languageNotes.test.ts __tests__/hooks/useSettings.test.ts __tests__/hooks/useSettingsNormalization.test.ts __tests__/utils/modelEffort.test.ts --runInBand --watchman=false",
    "speech:verify": "npm run typecheck && jest __tests__/constants/speechLanguages.test.ts __tests__/constants/providers/runtimeManifest.test.ts __tests__/components/settingsReadiness.test.ts __tests__/hooks/useAudioPlayer.test.ts __tests__/hooks/useSettings.test.ts __tests__/hooks/usePreviewVoiceController.test.ts __tests__/services/providerTtsRoute.test.ts __tests__/services/tts.test.ts __tests__/services/voicePipeline.test.ts __tests__/services/whisper.test.ts --runInBand --watchman=false",
    "catalog:generate-index": "python3 scripts/provider_catalog/generate_provider_index.py",
    "catalog:import-research-provider": "python3 scripts/provider_catalog/import_research_provider.py",
    "catalog:test": "jest __tests__/catalog --runInBand --watchman=false"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@ant-design/react-native": "^5.4.3",
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/unica-one": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-speech": "~55.0.16",
    "expo-speech-recognition": "^3.1.1",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-svg": "15.15.3",
    "react-native-uuid": "^2.0.1",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~55.0.23",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "react-dom": "19.2.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
