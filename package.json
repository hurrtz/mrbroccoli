{
  "name": "mrbroccoli",
  "version": "3.2.0",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:standalone": "node scripts/run-ios-standalone.mjs",
    "ios:standalone:test": "node --test scripts/run-ios-standalone.test.mjs",
    "config:verify": "node scripts/verify-native-config-sync.mjs",
    "prerelease:env:verify": "node scripts/verify-prerelease-env.mjs",
    "prerelease:env:test": "node --test scripts/verify-prerelease-env.test.mjs",
    "prerelease:live": "node scripts/run-live-provider-matrix.mjs",
    "prerelease:live:test": "node --test scripts/run-live-provider-matrix.test.mjs",
    "maestro:verify": "node scripts/verify-maestro-suite.mjs",
    "maestro:test": "node --test scripts/verify-maestro-suite.test.mjs",
    "maestro:prerelease": "node scripts/run-maestro-prerelease.mjs",
    "maestro:prerelease:test": "node --test scripts/run-maestro-prerelease.test.mjs scripts/run-screen-reader-check.test.mjs scripts/verify-maestro-artifacts.test.mjs",
    "maestro:screen-reader": "node scripts/run-screen-reader-check.mjs",
    "maestro:artifacts:verify": "node scripts/verify-maestro-artifacts.mjs",
    "store-promos:verify": "node scripts/verify-store-promos.mjs",
    "store-promos:test": "node --test scripts/verify-store-promos.test.mjs scripts/run-store-promos.test.mjs",
    "store-promos:ios": "node scripts/run-store-promos.mjs --platform ios",
    "store-promos:android": "node scripts/run-store-promos.mjs --platform android",
    "spec-review:test": "node --test scripts/pre-push-spec-review.test.mjs",
    "fresh-checkout": "node scripts/run-fresh-checkout-validation.mjs",
    "fresh-checkout:test": "node --test scripts/run-fresh-checkout-validation.test.mjs",
    "license:notices:generate": "node scripts/verify-licenses.mjs --write",
    "license:verify": "node scripts/verify-licenses.mjs",
    "postinstall": "node scripts/install-espeak-free-runtime.mjs --optional",
    "espeak-free:install": "node scripts/install-espeak-free-runtime.mjs",
    "espeak-free:verify": "node scripts/install-espeak-free-runtime.mjs --verify-installed",
    "license:test": "node --test scripts/verify-licenses.test.mjs",
    "release-notes:verify": "node scripts/verify-release-notes.mjs",
    "release-notes:test": "node --test scripts/verify-release-notes.test.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "pretest": "npm run config:verify",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --coverage",
    "lint": "eslint app src __tests__ __mocks__ data plugins scripts --max-warnings=0",
    "static:dead-code": "knip --include files,dependencies,unlisted,unresolved,cycles --reporter compact",
    "static:verify": "npm run lint && npm run static:dead-code",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests && npm run typecheck:scripts",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "i18n:verify": "npm run typecheck && jest __tests__/i18n/translations.test.ts __tests__/constants/localTts.test.ts __tests__/constants/kokoro.test.ts __tests__/constants/providers/languageNotes.test.ts __tests__/hooks/useSettings.test.ts __tests__/hooks/useSettingsNormalization.test.ts __tests__/utils/modelEffort.test.ts --runInBand --watchman=false",
    "speech:verify": "npm run typecheck && jest __tests__/constants/speechLanguages.test.ts __tests__/constants/providers/runtimeManifest.test.ts __tests__/components/settingsReadiness.test.ts __tests__/hooks/useAudioPlayer.test.ts __tests__/hooks/useSettings.test.ts __tests__/hooks/usePreviewVoiceController.test.ts __tests__/services/providerTtsRoute.test.ts __tests__/services/tts.test.ts __tests__/services/voicePipeline.test.ts __tests__/services/whisper.test.ts --runInBand --watchman=false",
    "catalog:generate-index": "python3 scripts/provider_catalog/generate_provider_index.py",
    "catalog:import-research-provider": "python3 scripts/provider_catalog/import_research_provider.py",
    "catalog:test": "jest __tests__/catalog --runInBand --watchman=false"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/unica-one": "^0.4.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-iap": "^5.0.0",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "llama.rn": "^0.12.8",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "knip": "^6.31.0",
    "parse-png": "^2.1.0",
    "react-dom": "19.2.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "ws": "^8.21.1"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
