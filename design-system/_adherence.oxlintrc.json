{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/chat/**",
              "components/core/**",
              "components/intro/**",
              "components/list/**",
              "components/on-device/**",
              "components/overlays/**",
              "components/settings-primitives/**",
              "components/workspace/**",
              "ui_kits/mobile-app/**",
              "ui_kits/settings/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Unica One|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Unica One, Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntButtonLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|icon|iconSize|label|key|ref|className|style|children)$/]",
        "message": "<AntButtonLabel> doesn't accept that prop. Declared props: color, icon, iconSize, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntDisclosureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|headerExtra|expanded|onToggle|children|footer|toggleAccessibilityLabel|style|key|ref|className|style|children)$/]",
        "message": "<AntDisclosureCard> doesn't accept that prop. Declared props: header, headerExtra, expanded, onToggle, children, footer, toggleAccessibilityLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntNumberInputRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|min|key|ref|className|style|children)$/]",
        "message": "<AntNumberInputRow> doesn't accept that prop. Declared props: label, value, onChange, min."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntPickerOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<AntPickerOption> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntPickerRows'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|helperText|key|ref|className|style|children)$/]",
        "message": "<AntPickerRows> doesn't accept that prop. Declared props: children, helperText."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntPickerSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|helperText|headerExtra|key|ref|className|style|children)$/]",
        "message": "<AntPickerSection> doesn't accept that prop. Declared props: title, children, helperText, headerExtra."
      },
      {
        "selector": "JSXOpeningElement[name.name='AntRadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|description|disabled|key|ref|className|style|children)$/]",
        "message": "<AntRadioOption> doesn't accept that prop. Declared props: value, label, description, disabled."
