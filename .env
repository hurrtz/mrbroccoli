# Mr Broccoli local pre-release environment contract.
#
# Keep this file committed with every supported key present and no secrets.
# Put local values in .env.local, which is ignored by Git. The pre-release
# credential check fails before any provider request when a required value is
# absent.

# LLM, web-search, and speech provider credentials
MR_BROCCOLI_OPENAI_API_KEY=
MR_BROCCOLI_OPENROUTER_API_KEY=
MR_BROCCOLI_ANTHROPIC_API_KEY=
MR_BROCCOLI_QWEN_API_KEY=
MR_BROCCOLI_QWEN_REGION=singapore
MR_BROCCOLI_GEMINI_API_KEY=
MR_BROCCOLI_XAI_API_KEY=
MR_BROCCOLI_DEEPSEEK_API_KEY=
MR_BROCCOLI_MISTRAL_API_KEY=
MR_BROCCOLI_ELEVENLABS_API_KEY=

# Release controls
MR_BROCCOLI_PRERELEASE_MAX_USD=
MR_BROCCOLI_ANDROID_KEYSTORE_PROPERTIES_FILE=android/keystore.properties
