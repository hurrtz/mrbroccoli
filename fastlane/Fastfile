# Store listing upload for Mr Broccoli.
#
# These lanes only ever push listing text and screenshots that were generated by
# `npm run listing:export` from reviewed sources in the repository. They never
# build anything: the Android binary comes from `make release-aab`, which has
# already verified its signature, secrets, size budget, R8 mapping and native
# symbols. Nothing here bypasses those gates.
#
# Metadata lanes are the everyday ones. The release lanes are deliberately
# separate so uploading corrected copy can never submit a build by accident.

default_platform(:ios)

# fastlane's working directory depends on how it was invoked — from the repo
# root or from inside fastlane/ — so never resolve the exported tree against
# Dir.pwd. Take the first candidate that actually contains this Fastfile.
FASTLANE_DIR = [
  __dir__,
  (FastlaneCore::FastlaneFolder.path if defined?(FastlaneCore::FastlaneFolder)),
  File.join(Dir.pwd, "fastlane"),
  Dir.pwd,
].compact
 .map { |candidate| File.expand_path(candidate) }
 .find { |candidate| File.exist?(File.join(candidate, "Fastfile")) } ||
  File.expand_path("fastlane", Dir.pwd)

def exported(*parts)
  File.join(FASTLANE_DIR, *parts)
end

# Paths typed on the command line are naturally relative to the repository root,
# but fastlane runs lanes from inside fastlane/. Resolve against the root first.
def repo_path(path)
  return nil if path.nil?
  from_root = File.expand_path(path, File.dirname(FASTLANE_DIR))
  File.exist?(from_root) ? from_root : File.expand_path(path)
end

def require_exported_tree
  missing = ["metadata", "screenshots"].reject { |dir| Dir.exist?(exported(dir)) }
  return if missing.empty?

  UI.user_error!(
    "fastlane/#{missing.join(' and fastlane/')} not found. " \
    "Run `npm run listing:export` first — deliver can clear a live listing " \
    "field whose file is missing.",
  )
end

# Credentials come from fastlane/.env, which fastlane loads automatically and
# .gitignore excludes. A blank value counts as missing: an empty entry in a
# dotenv file defines the variable, so ENV.fetch alone would not catch it.
def credential(name, hint)
  value = ENV[name].to_s.strip
  return value unless value.empty?

  UI.user_error!(
    "#{name} is not set.\n  #{hint}\n" \
    "Copy fastlane/.env.example to fastlane/.env and fill it in, " \
    "then run `bundle exec fastlane doctor`.",
  )
end

def credential_file(name, hint)
  path = credential(name, hint)
  UI.user_error!("#{name} points at #{path}, which does not exist.") unless File.exist?(path)
  path
end

APP_STORE_KEY = lambda do
  app_store_connect_api_key(
    key_id: credential("APP_STORE_CONNECT_API_KEY_ID", "App Store Connect -> Users and Access -> Integrations."),
    issuer_id: credential("APP_STORE_CONNECT_API_ISSUER_ID", "Shown above the key list on the same page."),
    key_filepath: credential_file("APP_STORE_CONNECT_API_KEY_PATH", "Path to the .p8 you downloaded, kept outside this repository."),
    in_house: false,
  )
end

PLAY_KEY = lambda do
  credential_file("SUPPLY_JSON_KEY", "Path to the Play service-account JSON, kept outside this repository.")
end

desc "Check credentials and the exported tree. Pass online:true to also ask"
desc "Google whether the Play service account actually authenticates."
lane :doctor do |options|
  APP_STORE_KEY.call
  play_key = PLAY_KEY.call
  require_exported_tree

  apple = Dir.glob(exported("metadata", "*")).reject { |p| p.end_with?("/android") }.length
  play = Dir.glob(exported("metadata", "android", "*")).length
  shots = Dir.glob(exported("**", "*.png")).length

  if options[:online]
    # Read-only: proves the key is valid and has been granted Play access.
    # Permission changes can take a few minutes to propagate after granting.
    validate_play_store_json_key(json_key: play_key)
    UI.success("Play service account authenticates.")
  end

  UI.success(
    "Credentials resolve. #{apple} App Store locales, #{play} Play locales, " \
    "#{shots} screenshots ready." +
    (options[:online] ? "" : " Run `fastlane doctor online:true` to test Play auth."),
  )
end

# Backing up a live listing is deliberately NOT a lane. `download_metadata` is a
# deliver subcommand rather than an option of the deliver action, and `supply`
# exposes no download at all, so neither fits the lane DSL. Both are documented
# as commands in docs/store-promo-screenshots.md instead of wrapped in a lane
# that cannot do what its name says.

platform :ios do
  # deliver has no metadata dry run. Its `verify_only` validates a binary, not
  # the listing, and with no IPA it fails inside verify_binary. The real safety
  # net is deliver's own HTML preview: without force:true it writes
  # fastlane/Preview.html and asks before uploading anything.
  desc "Upload App Store listing text and screenshots. No binary, no submission."
  desc "Shows an HTML preview and asks first; force:true skips that prompt."
  lane :metadata do |options|
    require_exported_tree
    deliver(
      api_key: APP_STORE_KEY.call,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
      overwrite_screenshots: true,
      # Leave the HTML preview confirmation on unless explicitly waived: it is
      # the last chance to notice copy going to the wrong locale.
      force: options[:force] || false,
      run_precheck_before_submit: false,
      skip_metadata: false,
      skip_screenshots: false,
    )
  end

end

platform :android do
  # Mr Broccoli is in closed testing on Play. Nothing here may reach production
  # by default or by omission: supply's own default track is "production", so
  # every call below passes one explicitly, and production needs saying out loud.
  # This app's closed-testing track is identified by its display name, spaces
  # and all. Unquoted in a shell the "#" starts a comment and truncates the
  # command, so `closed` is an alias for it.
  CLOSED_TRACK = "Mr Broccoli - Test #1"

  def resolve_track(options, purpose)
    track = options[:track]
    track = CLOSED_TRACK if track.to_s.casecmp("closed").zero?
    if track.nil?
      UI.user_error!(
        "Pass track:<name> for #{purpose} — the closed testing track, " \
        "usually `alpha` or your custom track name. There is no default on " \
        "purpose: supply defaults to production, and this app is in testing.",
      )
    end
    if track == "production" && !options[:allow_production]
      UI.user_error!(
        "Refusing to touch the production track. If that is genuinely what " \
        "you want, add allow_production:true.",
      )
    end
    track
  end

  # Without a binary to infer it from, supply cannot tell which release a
  # changelog belongs to. Read the same versionCode the exporter named the
  # changelog files after, so the two can never drift apart.
  def android_version_code
    gradle_path = File.expand_path("../android/app/build.gradle", FASTLANE_DIR)
    code = File.read(gradle_path)[/versionCode\s+(\d+)/, 1]
    UI.user_error!("Could not read versionCode from #{gradle_path}") if code.nil?
    code
  end

  desc "List every Play track with its releases and version codes."
  lane :tracks do
    require "supply"
    require "supply/client"

    package = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)
    # Enumerate rather than probing known names: a closed track created in the
    # console has a generated identifier, so guessing `alpha` reports a
    # different track that may hold an unrelated old build.
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options,
      { json_key: PLAY_KEY.call, package_name: package, track: "production" },
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package)
    begin
      UI.header("Play tracks for #{package}")
      client.tracks.each do |track|
        UI.success(track.track)
        releases = track.releases || []
        if releases.empty?
          UI.message("    no releases")
          next
        end
        releases.each do |release|
          codes = (release.version_codes || []).join(", ")
          UI.message(
            "    #{release.name || 'untitled'} " \
            "[#{release.status}] versionCode #{codes.empty? ? '—' : codes}",
          )
        end
      end
      UI.important("Pass the identifier shown on the left as track:<name>, " \
                   "or track:closed for #{CLOSED_TRACK}.")
      UI.important("Repository is at versionCode #{android_version_code}.")
    ensure
      client.abort_current_edit
    end
  end

  # Without a binary to infer it from, supply cannot tell which release a
  # changelog belongs to. Read the same versionCode the exporter named the
  # changelog files after, so the two can never drift apart.
  def android_version_code
    gradle_path = File.expand_path("../android/app/build.gradle", FASTLANE_DIR)
    code = File.read(gradle_path)[/versionCode\s+(\d+)/, 1]
    UI.user_error!("Could not read versionCode from #{gradle_path}") if code.nil?
    code
  end

  desc "Upload Play listing text and screenshots. No binary, no release track."
  desc "Changelogs are track-scoped, so they upload only when you pass track:<name>."
  lane :metadata do |options|
    require_exported_tree

    # Listing text and images belong to the app, not to a track. Changelogs are
    # the only track-scoped part, so without an explicit track this lane cannot
    # write to a release track at all.
    changelogs = !options[:track].nil?
    params = {
      json_key: PLAY_KEY.call,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: !changelogs,
      track: changelogs ? resolve_track(options, "changelogs") : "internal",
      # validate:true asks Google to check the upload and discard it.
      validate_only: options[:validate] ? true : false,
    }
    if changelogs
      # The release with this version code must already exist on that track;
      # a changelog updates release notes, it does not create a release.
      params[:version_code] = options[:version_code] || android_version_code
      UI.message("Changelogs target versionCode #{params[:version_code]} on #{params[:track]}.")
    end

    supply(**params)
    UI.important("Changelogs skipped — pass track:<name> to upload them.") unless changelogs
  end

  desc "Upload a verified AAB with its mapping, plus the listing."
  desc "Pass aab:<path> and track:<name>. Use the artifact make release-aab verified."
  lane :release do |options|
    require_exported_tree
    UI.user_error!("Pass aab:<path> to the verified artifact from make release-aab") if options[:aab].nil?
    aab = repo_path(options[:aab])
    UI.user_error!("No AAB at #{options[:aab]}") unless File.exist?(aab)
    track = resolve_track(options, "the release")

    # Play rejects an in-progress release at 100%: a fraction below 1 pairs with
    # "inProgress", a full release with "completed". Staged is the default for
    # production-shaped rollouts, but a closed track full of invited testers
    # generally wants all of them to get the build.
    rollout = (options[:rollout] || "1.0").to_s
    full = rollout.to_f >= 1.0
    params = {
      json_key: PLAY_KEY.call,
      aab: aab,
      mapping_paths: [repo_path(options[:mapping])].compact,
      track: track,
      skip_upload_apk: true,
      release_status: full ? "completed" : "inProgress",
    }
    params[:rollout] = rollout unless full
    UI.message("#{track}: #{full ? 'full release' : "staged at #{rollout}"}")

    supply(**params)
  end
end
